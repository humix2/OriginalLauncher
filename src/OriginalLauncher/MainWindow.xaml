<Window x:Class="OriginalLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OriginalLauncher"
        mc:Ignorable="d"
        Title="OriginalLauncher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="640"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#23262e" />
            <Setter Property="BorderBrush" Value="#34363e" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#f0efe9" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2c2f38" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="#1c1e24" BorderBrush="#34363e" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <Grid Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="&gt;"
                           FontFamily="Consolas"
                           FontSize="20"
                           Foreground="#e3a23d"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBox x:Name="QueryBox"
                         Grid.Column="1"
                         FontFamily="Consolas"
                         FontSize="19"
                         Foreground="#f0efe9"
                         CaretBrush="#f0efe9"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         TextChanged="QueryBox_TextChanged" />
                <Border x:Name="ModeHintBadge"
                        Grid.Column="2"
                        Background="#2c2f38"
                        CornerRadius="4"
                        Padding="8,3"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ModeHintText"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#e3a23d" />
                </Border>
            </Grid>
            <Border BorderThickness="0,1,0,0" BorderBrush="#2c2e36">
                <ListBox x:Name="ResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="320"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         ContextMenuOpening="ResultsList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="開く (Enter)" Click="OpenMenuItem_Click" />
                            <MenuItem Header="フォルダを開く (Ctrl+Enter)" Click="OpenFolderMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="20,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           FontFamily="Consolas"
                                           FontSize="13.5"
                                           Foreground="#cfcdc4"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        BorderBrush="#34363e"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,1">
                                    <TextBlock Text="{Binding Tag}"
                                               FontFamily="Consolas"
                                               FontSize="10.5"
                                               Foreground="#8a8d97" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </Border>
</Window>
