<Window x:Class="OriginalLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OriginalLauncher"
        mc:Ignorable="d"
        Title="OriginalLauncher - 設定"
        Width="640"
        Height="640"
        MinWidth="520"
        MinHeight="480"
        Background="#1c1e24"
        WindowStartupLocation="CenterScreen"
        FontFamily="Consolas">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#f0efe9" />
        <SolidColorBrush x:Key="InkFaint" Color="#8a8d97" />
        <SolidColorBrush x:Key="Accent" Color="#e3a23d" />
        <SolidColorBrush x:Key="Border" Color="#34363e" />
        <SolidColorBrush x:Key="Surface" Color="#23262e" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="RowBackground" Value="{StaticResource Surface}" />
            <Setter Property="AlternatingRowBackground" Value="#20222a" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#181a20" />
            <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2c2f38" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="起動キー" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Key:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="HotkeyKeyBox" Width="140" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="ModAltCheck" Content="Alt" />
                    <CheckBox x:Name="ModControlCheck" Content="Control" />
                    <CheckBox x:Name="ModShiftCheck" Content="Shift" />
                    <CheckBox x:Name="ModWindowsCheck" Content="Windows" />
                </StackPanel>
                <TextBlock Text="「CapsLock」のほか Space, F13, L のようなキー名を指定できます。修飾キーが揃わない場合、そのキー自体の通常入力は妨げません。"
                           Foreground="{StaticResource InkFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Text="インデックス対象ルート" Style="{StaticResource SectionHeader}" />
                <DataGrid x:Name="RootsGrid" Height="160" ItemsSource="{Binding Roots}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="3*" />
                        <DataGridTextColumn Header="深度" Binding="{Binding MaxDepth}" Width="60" />
                        <DataGridTextColumn Header="除外パス (; 区切り)" Binding="{Binding ExcludesText}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddRootButton" Content="フォルダを追加..." Click="AddRootButton_Click" />
                    <Button x:Name="RemoveRootButton" Content="削除" Click="RemoveRootButton_Click" />
                </StackPanel>

                <TextBlock Text="最大表示件数" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="MaxResultsBox" Width="80" HorizontalAlignment="Left" />

                <TextBlock Text="検索ショートカット" Style="{StaticResource SectionHeader}" />
                <DataGrid x:Name="ShortcutsGrid" Height="140" ItemsSource="{Binding SearchShortcuts}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="プレフィックス" Binding="{Binding Prefix}" Width="100" />
                        <DataGridTextColumn Header="説明 (入力欄の右側に表示)" Binding="{Binding Description}" Width="160" />
                        <DataGridTextColumn Header="URL ({query} が検索語に置き換わる)" Binding="{Binding UrlTemplate}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddShortcutButton" Content="追加" Click="AddShortcutButton_Click" />
                    <Button x:Name="RemoveShortcutButton" Content="削除" Click="RemoveShortcutButton_Click" />
                </StackPanel>
                <TextBlock Text="プレフィックスちょうどを入力すると入力欄がクリアされ、説明が右側に表示された「待機状態」になります。続けて検索語を入力して Enter で実行します（Esc で待機状態のみ解除）。&#10;例: /m 説明=GoogleMap検索 URL=https://www.google.com/maps/search/{query}　/a 説明=Amazon検索 URL=https://www.amazon.co.jp/s?k={query}"
                           Foreground="{StaticResource InkFaint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource InkFaint}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="キャンセル" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
